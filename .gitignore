!assets/**
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.webp
!examples/
!examples/**
!examples/**/*.png
!examples/**/*.jpg
!examples/**/*.jpeg
!examples/**/*.webp

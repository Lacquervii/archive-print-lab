# Generated and local working artifacts
.DS_Store
__pycache__/
*.py[cod]
*.swp
*.tmp
.env
.env.*

# Do not commit arbitrary image outputs or private archives.
# Curated README visuals under assets/ and public examples/ are intentionally tracked.
*.png
*.jpg
*.jpeg
*.webp
*.pdf
